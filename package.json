{
  "name": "frogpaper-website",
  "version": "1.0.0",
  "description": "FrogPaper website with local Tailwind CSS",
  "scripts": {
    "build-css": "tailwindcss -i ./input.css -o ./output.css --minify",
    "watch-css": "tailwindcss -i ./input.css -o ./output.css --watch",
    "validate:html": "html-validate index.html downloads.html submit-wallpaper.html 404.html"
  },
  "devDependencies": {
    "html-validate": "^9.7.1",
    "tailwindcss": "^3.4.17"
  }
}
